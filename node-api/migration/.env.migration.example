# Copy to node-api/.env.migration and fill in the real value.
# Never commit .env.migration (already gitignored at the repo root).
#
# This is the ONLY new credential this migration tool needs — it reuses your
# existing .env.node's MONGODB_URI for the read-only source connection.

# Firestore with MongoDB compatibility — OIDC connection string, exactly as
# generated by Google Cloud (e.g. via `gcloud firestore databases
# connection-string`). Do not add or remove any query parameters by hand.
FIRESTORE_MONGODB_URI=mongodb://<DATABASE_UID>.<LOCATION>.firestore.goog:443/<DATABASE_ID>?loadBalanced=true&tls=true&retryWrites=false&authMechanism=MONGODB-OIDC&authMechanismProperties=ENVIRONMENT:gcp,TOKEN_RESOURCE:FIRESTORE

# Authentication is via Application Default Credentials, not a password in
# this URI. Locally, run:  gcloud auth application-default login
# (using an identity/service account that has been granted the Firestore
# IAM role needed for this database — confirm this is set up before running
# migrate.js; the first connection attempt will fail clearly if it isn't.)

# --- Optional tuning (defaults shown) ---
# MIGRATION_BATCH_SIZE=500
# MIGRATION_BATCH_DELAY_MS=0
# MIGRATION_MAX_RETRIES=5
# MIGRATION_RETRY_BASE_DELAY_MS=500
