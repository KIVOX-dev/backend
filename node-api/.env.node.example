# ============================================================================
# Skillovate Node/Express API — Environment Configuration
# Copy to .env.node and fill in real values. Never commit .env.node.
# (Kept separate from the existing Python service's .env.example on purpose —
#  that file is still read by the FastAPI app in app/config.py.)
# ============================================================================

# --- Application ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (Google Cloud SQL for PostgreSQL) ---
# Either set DATABASE_URL directly, or the discrete DB_* vars below (used as a fallback).
DATABASE_URL=postgresql://skillovate:changeme@localhost:5432/skillovate
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillovate
DB_USER=skillovate
DB_PASSWORD=changeme
DB_SSL=false
# Connection pool
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# --- JWT ---
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-different-random-64-char-string
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
