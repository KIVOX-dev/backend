# ============================================================================
# UpScaler-AI Node/Express API — Environment Configuration
# Copy to .env.node and fill in real values. Never commit .env.node.
# (Kept separate from the existing Python service's .env.example on purpose —
#  that file is still read by the FastAPI app in app/config.py.)
# ============================================================================

# --- Application ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (MongoDB) ---
# Use a distinct MONGODB_DB_NAME from the Python service's database (upscaler_ai) so the two
# services never share/collide on the same collections.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=upscaler_ai_node
# Connection pool (driver default is 100 if unset)
MONGO_POOL_MAX=20
# Only set this if `npm run db:test` fails with "querySrv ECONNREFUSED" — some local
# networks/VPNs use a DNS resolver that can't answer mongodb+srv://'s SRV lookups.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- JWT ---
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-different-random-64-char-string
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Auth-specific limiter (login/register/OAuth) — separate, stricter budget from the general
# limiter above. Defaults to 20/15min if unset; only override for local load-testing.
# AUTH_RATE_LIMIT_MAX=20
# Public kiosk lookup limiter (/students/identify) — separate, stricter budget from the general
# limiter above. Defaults to 10/15min if unset; only override for local load-testing.
# IDENTIFY_RATE_LIMIT_MAX=10

# --- Redis (optional) ---
# Enables Redis-backed rate limiting and cross-instance WebSocket chat broadcasting — see
# docs/DEPLOYMENT.md §8 and docs/OPERATIONS.md. Unset by default: every Redis-backed feature
# falls back to correct single-instance-only behavior with no Redis running at all. Only needed
# once running more than one instance behind a load balancer.
# REDIS_URL=redis://localhost:6379

# --- Groq (AI resume/interview features) ---
# Optional: routes that need it degrade gracefully when this is unset.
GROQ_API_KEY=

# --- Brevo (transactional email: password reset, email verification) ---
# Optional: routes that need it degrade gracefully when this is unset (email
# just doesn't send — see src/services/email.service.js).
BREVO_API_KEY=
# Must be a verified sender identity in your Brevo account.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=UpScaler-AI

# --- Frontend ---
# Used to build the links inside password-reset/verification emails.
FRONTEND_URL=http://localhost:3000
