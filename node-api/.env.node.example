# ============================================================================
# UpScaler-AI Node/Express API — Environment Configuration
# Copy to .env.node and fill in real values. Never commit .env.node.
# (Kept separate from the existing Python service's .env.example on purpose —
#  that file is still read by the FastAPI app in app/config.py.)
# ============================================================================

# --- Application ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (MongoDB) ---
# Use a distinct MONGODB_DB_NAME from the Python service's database (upscaler_ai) so the two
# services never share/collide on the same collections.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=upscaler_ai_node
# Connection pool (driver default is 100 if unset)
MONGO_POOL_MAX=20
# Only set this if `npm run db:test` fails with "querySrv ECONNREFUSED" — some local
# networks/VPNs use a DNS resolver that can't answer mongodb+srv://'s SRV lookups.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- JWT ---
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-different-random-64-char-string
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- GitHub OAuth (Integrations tab: students connecting a GitHub account) ---
# From your GitHub OAuth App (github.com/settings/applications/new). Optional:
# GET /auth/github/connect returns 503 until all three are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must exactly match the app's "Authorization callback URL".
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback
# A personal access token for the TalentSnaps GitHub account (Settings ->
# Developer settings -> Personal access tokens). No scopes required — only
# used for read-only GraphQL queries of PUBLIC contribution calendars, never
# a student's own token. Optional: GET /auth/me/activity-heatmap falls back
# to platform-only activity (logins/tests/interviews) when unset.
GITHUB_APP_TOKEN=

# --- LinkedIn OAuth (Integrations tab: students connecting LinkedIn) ---
# From your LinkedIn app (developer.linkedin.com) with the "Sign In with
# LinkedIn using OpenID Connect" product added — that product is
# auto-approved, no partner review needed, but only grants openid/profile/
# email scope (verified name/email/photo), not work history or skills.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/v1/auth/linkedin/callback

# --- Stack Exchange OAuth (Integrations tab: students connecting Stack Overflow) ---
# Register at stackapps.com/apps/oauth/register.
STACKEXCHANGE_CLIENT_ID=
STACKEXCHANGE_CLIENT_SECRET=
# Separate "app key" Stack Exchange issues alongside the client id/secret —
# required on every API call together with the access token.
STACKEXCHANGE_KEY=
STACKEXCHANGE_CALLBACK_URL=http://localhost:5000/api/v1/auth/stackexchange/callback

# --- Google Cloud Storage (student profile photo / cover banner uploads) ---
# Cloud Run's own filesystem is wiped on every restart/redeploy/scale event,
# so uploaded images can't just be written to local disk (see
# middlewares/upload.js's verifyAndUploadToGcs vs the onboarding-photo
# verifyAndPersist it's modeled on). On Cloud Run, no credentials are needed
# here beyond this bucket name — Application Default Credentials come from
# the attached service account automatically. Locally, run
# `gcloud auth application-default login` first. Optional: POST
# /students/profile/avatar and /cover return 503 until this is set.
GCS_BUCKET_NAME=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Auth-specific limiter (login/register/OAuth) — separate, stricter budget from the general
# limiter above. Defaults to 20/15min if unset; only override for local load-testing.
# AUTH_RATE_LIMIT_MAX=20
# Public kiosk lookup limiter (/students/identify) — separate, stricter budget from the general
# limiter above. Defaults to 10/15min if unset; only override for local load-testing.
# IDENTIFY_RATE_LIMIT_MAX=10

# --- Redis (optional) ---
# Enables Redis-backed rate limiting and cross-instance WebSocket chat broadcasting — see
# docs/DEPLOYMENT.md §8 and docs/OPERATIONS.md. Unset by default: every Redis-backed feature
# falls back to correct single-instance-only behavior with no Redis running at all. Only needed
# once running more than one instance behind a load balancer.
# REDIS_URL=redis://localhost:6379

# --- Groq (AI resume/interview features) ---
# Optional: routes that need it degrade gracefully when this is unset.
GROQ_API_KEY=

# --- Brevo (transactional email: password reset, email verification) ---
# Optional: routes that need it degrade gracefully when this is unset (email
# just doesn't send — see src/services/email.service.js).
BREVO_API_KEY=
# Must be a verified sender identity in your Brevo account.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=UpScaler-AI

# --- Frontend ---
# Used to build the links inside password-reset/verification emails.
FRONTEND_URL=http://localhost:3000

# --- Cloudflare Turnstile (bot protection on /auth/register and /auth/forgot-password) ---
# Secret key from the Cloudflare dashboard for this widget. Required — the app
# won't start without it (same as the JWT secrets above).
TURNSTILE_SECRET_KEY=
# Optional comma-separated allow-list of hostnames the widget may be served
# from (checked against siteverify's `hostname` response field). Leave unset
# in development; set to your production frontend domain(s) once known.
# TURNSTILE_HOSTNAMES=talentsnaps.com
